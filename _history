number,    \r\n    xp: number,        \r\n    maxXp: number,\r\n    maxHealth: number,\r\n    health: number,\r\n    minDmg: number,   \r\n    maxDmg: number,   \r\n    icon: Image,\r\n    gender: string\r\n}\r\n\r\nenum FightMode {\r\n    Fight,\r\n    Run,\r\n    Heal\r\n}\r\n\r\nlet activeBattleChoice: FightMode = FightMode.Fight;\r\n\r\nlet cursorPosition: number = 0;\r\n\r\nlet playerDirection: string = \"none\";\r\n\r\nlet speaking: boolean = false;\r\nlet gamePlay: boolean = false;\r\nlet activeBattle: boolean = false;\r\nlet inventoryOpen: boolean = false;\r\n\r\nlet bigButton: Sprite = sprites.create(assets.image`bigButtonPress0`, SpriteKind.Player);\r\nlet inventory: Sprite = null;\r\nlet player: Sprite = null;\r\nlet npc1: Sprite = null;\r\nlet npc2: Sprite = null;\r\nlet healer: Sprite = null;\r\nlet playerBattleSprite: Sprite = null;\r\nlet enemyBattleSprite: Sprite = null;\r\nlet playerHPBar: Sprite = null;\r\nlet enemyHPBar: Sprite = null;\r\nlet fightMenuBox: Sprite = null;\r\nlet fightDialogBox: Sprite = null;\r\nlet playerStatusBox: Sprite = null;\r\nlet enemyStatusBox: Sprite = null;\r\nlet battleCursor: Sprite = null;\r\n\r\nlet currentEnemy: Monster;\r\nlet monsterArray: Monster[] = [\r\n    { name: 'Opice', level: 1, xp: 0, maxXp: 100, maxHealth: 80, health: 80, minDmg: 8, maxDmg: 14, icon: assets.image`forestMonkey`, gender: \"F\" }, // Balanced\r\n    { name: 'Had', level: 1, xp: 0, maxXp: 100, maxHealth: 50, health: 50, minDmg: 15, maxDmg: 25, icon: assets.image`forestSnake`, gender: \"M\" },  // Glass Cannon (málo HP, velký DMG)\r\n    { name: 'Krab', level: 1, xp: 0, maxXp: 100, maxHealth: 120, health: 120, minDmg: 4, maxDmg: 8, icon: assets.image`hermitCrab`, gender: \"M\" }  // Tank (hodně HP, malý DMG)\r\n]\r\nlet wildMonsters: Monster[] = [\r\n    { name: \"Kachna\", level: 0, xp: 0, maxXp: 0, maxHealth: 80, health: 80, minDmg: 7, maxDmg: 13, icon: assets.image`duck`, gender: \"F\" },\r\n    { name: \"Žralok\", level: 0, xp: 0, maxXp: 0, maxHealth: 50, health: 50, minDmg: 18, maxDmg: 25, icon: assets.image`shark`, gender: \"M\" },\r\n    { name: \"Godzilka\", level: 0, xp: 0, maxXp: 0, maxHealth: 150, health: 150, minDmg: 5, maxDmg: 10, icon: assets.image`miniGodzilla`, gender: \"F\" },\r\n    { name: \"Škeble\", level: 0, xp: 0, maxXp: 0, maxHealth: 100, health: 100, minDmg: 6, maxDmg: 12, icon: assets.image`clam`, gender: \"F\" },\r\n    { name: \"M. Ryba\", level: 0, xp: 0, maxXp: 0, maxHealth: 40, health: 40, minDmg: 20, maxDmg: 35, icon: assets.image`magiTang`, gender: \"F\" }\r\n]\r\n\r\nconst backgrounds: Image[] = [\r\n    assets.image`castle`,\r\n    assets.image`castle2`,\r\n    assets.image`world`,\r\n    assets.image`field`,\r\n]\r\n\r\nfunction showIntro() {\r\n    gamePlay = false;\r\n\r\n    color.startFade(color.originalPalette, color.White, 200);\r\n    pause(250);\r\n    color.startFade(color.White, color.originalPalette, 1000);\r\n    scene.setBackgroundImage(null);\r\n    \r\n    scene.setBackgroundColor(15); //Black\r\n\r\n    pause(100);\r\n    story.printCharacterText(\"Svět, jak jsi ho znal, utichl...\");\r\n    story.printCharacterText(\"V hlubokých lesech se probudila prastará stvoření.\");\r\n    story.printCharacterText(\"Tvé dobrodružství začíná právě teď!\");\r\n\r\n    startGame();\r\n}\r\n\r\nfunction createTextSprite(text: string, width: number, height: number, x: number, y: number, kind: number, z: number): Sprite {\r\n    let name = image.create(width, height);\r\n    let textX = (width - (text.length * 6)) / 2;\r\n    \r\n    name.print(text, textX, 0, 15);\r\n\r\n    let textSprite = sprites.create(name, kind);\r\n    textSprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    textSprite.z = z;\r\n\r\n    textSprite.setPosition(x, y);\r\n    \r\n    return textSprite;\r\n}\r\n\r\nfunction createUISprite(img: Image, x: number, y: number): Sprite {\r\n    let sprite = sprites.create(img, SpriteKind.BattleUI);\r\n    sprite.setPosition(x, y);\r\n    sprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    sprite.z = 20;\r\n    return sprite;\r\n}\r\n\r\nfunction createHealthBarSprite(current: number, max: number, width: number, height: number, x: number, y: number, kind: number, z: number): Sprite {\r\n    let bar = image.create(width, height);\r\n    bar.fill(15); //Black\r\n\r\n    let currentWidth = Math.constrain((current / max) * (width - 2), 0, width - 2);\r\n\r\n    let color = 7; //Green\r\n    if (current < max * 0.5) color = 5; //Yellow\r\n    else if (current < max * 0.2) color = 2; //Red\r\n\r\n    if (currentWidth > 0) bar.fillRect(1, 1, currentWidth, height - 2, color);\r\n\r\n    let barSprite = sprites.create(bar, kind);\r\n    barSprite.setPosition(x ,y);\r\n    barSprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    barSprite.z = z;\r\n    \r\n    return barSprite;\r\n}\r\n\r\nfunction updateBattleHealthBars() {\r\n    sprites.destroyAllSpritesOfKind(SpriteKind.BattleHP);\r\n\r\n    enemyHPBar = createHealthBarSprite(\r\n        currentEnemy.health,\r\n        currentEnemy.maxHealth,\r\n        35, 5,\r\n        enemyStatusBox.x - 7,\r\n        enemyStatusBox.y + 3,\r\n        SpriteKind.BattleHP,\r\n        25\r\n    );\r\n\r\n    playerHPBar = createHealthBarSprite(\r\n        monsterArray[0].health,\r\n        monsterArray[0].maxHealth,\r\n        35, 5,\r\n        playerStatusBox.x,\r\n        playerStatusBox.y + 3,\r\n        SpriteKind.BattleHP,\r\n        25\r\n    );\r\n}\r\n\r\nfunction getAdjective(gender: string): string {\r\n    if (gender === \"M\") return \"Divoký\";\r\n    if (gender === \"F\") return \"Divoká\";\r\n    if (gender === \"N\") return \"Divoké\";\r\n    return \"Divoký\"\r\n}\r\n\r\nfunction updateCursorDisplay() {\r\n    let boxLeft = 125 - 35; // 90\r\n    let boxTop = 105 - 15;  // 90\r\n\r\n    let x = 0;\r\n    let y = 0;\r\n\r\n    if (activeBattleChoice === FightMode.Fight) {\r\n        battleCursor.setImage(assets.image`battleCursor`);\r\n        x = boxLeft + 35;\r\n        y = boxTop + 8;\r\n    } else if (activeBattleChoice === FightMode.Run) {\r\n        battleCursor.setImage(assets.image`battleCursor`);\r\n        x = boxLeft + 35;\r\n        y = boxTop + 22;\r\n    } else if (activeBattleChoice === FightMode.Heal) {\r\n        battleCursor.setImage(assets.image`battleCursorFlipped`);\r\n        x = boxLeft + 39;\r\n        y = boxTop + 8;\r\n    }\r\n\r\n    battleCursor.setPosition(x, y);\r\n    battleCursor.z = 25;\r\n}\r\n\r\nfunction showBattleBanner(text: string, duration: number) {\r\n    let bannerImg = image.create(160, 20);\r\n    bannerImg.fill(15); \r\n\r\n    let textX = (160 - (text.length * 6)) / 2;\r\n    bannerImg.print(text, textX, 6, 1);\r\n\r\n    let banner = sprites.create(bannerImg, SpriteKind.BattleUI);\r\n    banner.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    banner.z = 200;\r\n    banner.setPosition(80, 60); \r\n\r\n    banner.x = 240;      \r\n    banner.vx = -600;     \r\n    pause(350);         \r\n    banner.vx = 0;       \r\n    banner.x = 80;\r\n    \r\n    pause(duration);\r\n    banner.destroy();\r\n}\r\n\r\nfunction startGame() {\r\n    if (!gamePlay) {\r\n        color.startFade(color.Black, color.originalPalette, 1000);\r\n        tiles.setCurrentTilemap(tilemap`mainLocation`);\r\n        player = sprites.create(assets.image`playerModel`, SpriteKind.Player);\r\n        controller.moveSprite(player);\r\n        scene.cameraFollowSprite(player);\r\n        npc1 = sprites.create(assets.image`npc1`, SpriteKind.Enemy);\r\n        tiles.placeOnTile(npc1, tiles.getTileLocation(39, 13));\r\n        npc2 = sprites.create(assets.image`npc2`, SpriteKind.Enemy);\r\n        tiles.placeOnTile(npc2, tiles.getTileLocation(10, 33));\r\n        gamePlay = true;\r\n    }\r\n}\r\n\r\nfunction checkLevelUp(monster: Monster) {\r\n    if (monster.xp >= monster.maxXp) {\r\n        monster.level += 1;\r\n        monster.xp -= monster.maxXp;\r\n        monster.maxXp = Math.floor(monster.maxXp * 1.5);\r\n\r\n\r\n        monster.maxHealth = Math.floor(monster.maxHealth * 1.2);\r\n        monster.health = monster.maxHealth;\r\n        monster.minDmg = Math.floor(monster.minDmg * 1.2);\r\n        monster.maxDmg = Math.floor(monster.maxDmg * 1.2);\r\n\r\n        showBattleBanner(monster.name + \" postoupil na lvl \" + monster.level + \"!\", 1500);\r\n    }\r\n}\r\n\r\nfunction writeSmallFont(text: string, x: number, y: number, z: number, kind: number): Sprite {\r\n    let sprite = textsprite.create(text, 0, 15);\r\n    \r\n    sprite.setMaxFontHeight(5);\r\n    sprite.setKind(kind);\r\n    sprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    sprite.z = z;\r\n    sprite.setPosition(x, y);\r\n\r\n    return sprite;\r\n}\r\n\r\nfunction teleport(location: tiles.Location) {\r\n    let x = location.column;\r\n    let y = location.row;\r\n\r\n    if (x === 34 && (y >= 6 && y <= 8)) {\r\n        color.startFade(color.originalPalette, color.Black, 500);\r\n        if (healer) healer.destroy();\r\n        healer = sprites.create(assets.image`healer`, SpriteKind.Enemy);\r\n        tiles.setCurrentTilemap(tilemap`hospital`);\r\n        tiles.placeOnTile(player, tiles.getTileLocation(2,7));\r\n        tiles.placeOnTile(healer, tiles.getTileLocation(11, 7));\r\n        color.startFade(color.Black, color.originalPalette, 500);\r\n    }\r\n}\r\n\r\nfunction toggleMenu() {\r\n    if (inventory === null) {\r\n        if (speaking || activeBattle) return;\r\n        inventoryOpen = true;\r\n        controller.moveSprite(player, 0, 0);\r\n        inventory = sprites.create(assets.image`inventory`, SpriteKind.Menu);\r\n        inventory.setFlag(SpriteFlag.RelativeToCamera, true);\r\n        inventory.setPosition(80, 60);\r\n        inventory.z = 100;\r\n\r\n        for (let i: number = 0; i < monsterArray.length; i++) {\r\n            let sprite = sprites.create(monsterArray[i].icon, SpriteKind.MenuIcon);\r\n            let monster: Monster = monsterArray[i];\r\n            sprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n            sprite.z = 101;\r\n            let offset = (monsterArray.length - 1) / 2;\r\n            sprite.setPosition(80 + (i - offset) * 48, 40);\r\n            \r\n            checkLevelUp(monster);\r\n            \r\n            createHealthBarSprite(\r\n                monster.health, \r\n                monster.maxHealth,\r\n                24, 5, //Width, height\r\n                sprite.x, \r\n                sprite.y + 18, \r\n                SpriteKind.MenuHP, \r\n                102 //Z index\r\n            );\r\n\r\n            createTextSprite(monster.name, 50, 8, sprite.x, sprite.y - 15, SpriteKind.MenuText, 102);\r\n            writeSmallFont(monster.health + \"/\" + monster.maxHealth, sprite.x, sprite.y + 25, 102, SpriteKind.Text);\r\n            writeSmallFont(monster.xp + \"/\" + monster.maxXp, sprite.x, sprite.y + 38, 102, SpriteKind.Text);\r\n            writeSmallFont(monster.minDmg + \"-\" + monster.maxDmg, sprite.x, sprite.y + 46, 102, SpriteKind.Text);\r\n            \r\n            let xpBarImg = image.create(30, 3);\r\n            xpBarImg.fill(15);\r\n            let xpWidth = Math.constrain((monster.xp / monster.maxXp) * 28, 0, 28);\r\n            if (xpWidth > 0) xpBarImg.fillRect(1, 1, xpWidth, 3, 9); //Light blue\r\n            let xpBar = sprites.create(xpBarImg, SpriteKind.MenuHP);\r\n            xpBar.setPosition(sprite.x, sprite.y + 32);\r\n            xpBar.setFlag(SpriteFlag.RelativeToCamera, true);\r\n            xpBar.z = 102;\r\n        }\r\n\r\n    } else if (inventory) {\r\n        inventory.destroy();\r\n        sprites.destroyAllSpritesOfKind(SpriteKind.MenuIcon);\r\n        sprites.destroyAllSpritesOfKind(SpriteKind.MenuHP);\r\n        sprites.destroyAllSpritesOfKind(SpriteKind.MenuText);\r\n        sprites.destroyAllSpritesOfKind(SpriteKind.Text);\r\n        inventory = null;\r\n        inventoryOpen = false;\r\n        controller.moveSprite(player, 100, 100);\r\n    }\r\n}\r\n\r\nfunction startFight() {\r\n    color.startFade(color.originalPalette, color.Black, 200);\r\n    scene.cameraFollowSprite(null);\r\n    scene.centerCameraAt(80, 60);\r\n    let randomMonsterNumber = randint(0, wildMonsters.length - 1);\r\n    let randomBackgroundNumber = randint(0, backgrounds.length - 1);\r\n    \r\n    activeBattle = true;\r\n    player.setFlag(SpriteFlag.Invisible, true);\r\n    tiles.setCurrentTilemap(null);\r\n    scene.setBackgroundImage(backgrounds[randomBackgroundNumber]);\r\n    currentEnemy = wildMonsters[randomMonsterNumber];\r\n    \r\n    fightDialogBox = createUISprite(assets.image`dialogFightBox`, 50, 105);\r\n    fightMenuBox = createUISprite(assets.image`fightMenu`, 125, 105);\r\n    enemyStatusBox = createUISprite(assets.image`enemyStatusBox`, 45, 15);\r\n    playerStatusBox = createUISprite(assets.image`playerStatusBox`, 126, 78);\r\n    \r\n    playerBattleSprite = sprites.create(monsterArray[0].icon, SpriteKind.PlayerBattleSprite);\r\n    enemyBattleSprite = sprites.create(currentEnemy.icon, SpriteKind.EnemyBattleSprite);\r\n    \r\n    playerBattleSprite.setScale(2);\r\n    enemyBattleSprite.setScale(2);\r\n    \r\n    playerBattleSprite.setPosition(40, 75);\r\n    enemyBattleSprite.setPosition(120, 35);\r\n    \r\n    playerBattleSprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    enemyBattleSprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    \r\n    playerBattleSprite.z = 10;\r\n    enemyBattleSprite.z = 10;\r\n    \r\n    enemyHPBar = createHealthBarSprite(\r\n        currentEnemy.health,\r\n        currentEnemy.maxHealth, \r\n        35, 5, //Width, height\r\n        enemyStatusBox.x - 7, \r\n        enemyStatusBox.y + 3, \r\n        SpriteKind.BattleHP, \r\n        25 //Z index\r\n    );\r\n    \r\n    playerHPBar = createHealthBarSprite(\r\n        monsterArray[0].health, \r\n        monsterArray[0].maxHealth, \r\n        35, 5, //Width, height\r\n        playerStatusBox.x, \r\n        playerStatusBox.y + 3, \r\n        SpriteKind.BattleHP, \r\n        25 //Z index\r\n    );\r\n    \r\n    createTextSprite(currentEnemy.name, \r\n        50, 8, //Width, height\r\n        enemyHPBar.x + 3, \r\n        enemyHPBar.y - 8, \r\n        SpriteKind.EnemyBattleName, \r\n        25 //Z index\r\n    );\r\n    \r\n    createTextSprite(monsterArray[0].name, \r\n        50, 8, //Width, height\r\n        playerHPBar.x + 1, \r\n        playerHPBar.y - 8, \r\n        SpriteKind.PlayerBattleName, \r\n        25 //Z index\r\n    );\r\n\r\n    battleCursor = sprites.create(assets.image`battleCursor`, SpriteKind.BattleUI);\r\n    battleCursor.z = 100;\r\n    battleCursor.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    updateCursorDisplay();\r\n    \r\n    let adjective = getAdjective(currentEnemy.gender);\r\n    color.startFade(color.Black, color.originalPalette, 200);\r\n    story.printCharacterText(`${adjective} ${wildMonsters[randomMonsterNumber].name} na tebe útočí!`);\r\n    pause(500);\r\n\r\n    let coinflip = randint(1, 2);\r\n\r\n    if (coinflip === 1) {\r\n        showBattleBanner(\"Začínáš!\", 1500);\r\n        startBattleTurn(\"Player\");\r\n    } else {\r\n        showBattleBanner(`${currentEnemy.name} začíná první!`, 1500);\r\n        startBattleTurn(\"Enemy\");\r\n    }\r\n}\r\n\r\nfunction endBattle() {\r\n    activeBattle = false;\r\n\r\n    color.startFade(color.originalPalette, color.Black, 500);\r\n    pause(500);\r\n\r\n    sprites.destroyAllSpritesOfKind(SpriteKind.BattleUI);\r\n    sprites.destroyAllSpritesOfKind(SpriteKind.BattleHP);\r\n    sprites.destroyAllSpritesOfKind(SpriteKind.PlayerBattleSprite);\r\n    sprites.destroyAllSpritesOfKind(SpriteKind.EnemyBattleSprite);\r\n    sprites.destroyAllSpritesOfKind(SpriteKind.EnemyBattleName);\r\n    sprites.destroyAllSpritesOfKind(SpriteKind.PlayerBattleName);\r\n\r\n    tiles.setCurrentTilemap(tilemap`mainLocation`); \r\n    player.setFlag(SpriteFlag.Invisible, false);\r\n    scene.cameraFollowSprite(player);\r\n\r\n    color.startFade(color.Black, color.originalPalette, 500);\r\n    gamePlay = true;\r\n}\r\n\r\nfunction executeAttack(attackerName: string, target: any, isPlayerAttacking: boolean) {\r\n    showBattleBanner(attackerName + \" útočí!\", 1000);\r\n\r\n    let attacker: Monster = isPlayerAttacking ? monsterArray[0] : currentEnemy; \r\n    \r\n    let damage = randint(attacker.minDmg, attacker.maxDmg);\r\n    let criticalDmg = randint(1, 10);\r\n    let criticalStrike: boolean = false;\r\n\r\n    if (criticalDmg === 1 && !isPlayerAttacking) {\r\n        criticalStrike = true;\r\n        playerBattleSprite.setFlag(SpriteFlag.RelativeToCamera, false);\r\n\r\n        scene.cameraShake(8, 500); \r\n        pause(500);\r\n\r\n        playerBattleSprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n        \r\n        damage = Math.round((damage + 2) * 1.5);\r\n\r\n    } else if (criticalDmg === 1) {\r\n        criticalStrike = true;\r\n        enemyBattleSprite.setFlag(SpriteFlag.RelativeToCamera, false);\r\n\r\n        scene.cameraShake(8, 500);\r\n        pause(500);\r\n\r\n        enemyBattleSprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n        \r\n        damage = Math.round((damage + 2) * 1.5);\r\n    }\r\n    \r\n    target.health -= damage;\r\n    if (target.health < 0) target.health = 0;\r\n\r\n    if (isPlayerAttacking) {\r\n        enemyBattleSprite.setFlag(SpriteFlag.Invisible, true);\r\n        pause(100);\r\n        enemyBattleSprite.setFlag(SpriteFlag.Invisible, false);\r\n    } else {\r\n        playerBattleSprite.setFlag(SpriteFlag.Invisible, true);\r\n        pause(100);\r\n        playerBattleSprite.setFlag(SpriteFlag.Invisible, false);\r\n    }\r\n    \r\n    updateBattleHealthBars();\r\n\r\n    pause(100);\r\n    !criticalStrike ? showBattleBanner(\"Ubráno \" + damage + \" HP\", 1000) : showBattleBanner(\"Kritický zásah za \" + damage + \" HP\", 1000)\r\n    pause(500);\r\n}\r\n\r\nfunction executeHeal(targetName: string, target: Monster) {\r\n    let heal = randint(10, 20);\r\n    let oldHealth = target.health;\r\n    target.health += heal;\r\n\r\n    if (target.health > target.maxHealth) {\r\n        target.health = target.maxHealth;\r\n    }\r\n\r\n    let actualHeal = target.health - oldHealth;\r\n\r\n    showBattleBanner(targetName + \" se léčí!\", 1000);\r\n\r\n    updateBattleHealthBars();\r\n\r\n    if (actualHeal > 0) {\r\n        showBattleBanner(\"Obnoveno \" + actualHeal + \" HP\", 1000);\r\n    } else {\r\n        showBattleBanner(\"Zdraví je již plné!\", 1000);\r\n    }\r\n\r\n    pause(500);\r\n}\r\n\r\nfunction startBattleTurn(turn: string) {\r\n    if (turn === \"Player\") {\r\n        activeBattle = true;\r\n        battleCursor.setFlag(SpriteFlag.Invisible, false);\r\n    } else {\r\n        activeBattle = false;\r\n        battleCursor.setFlag(SpriteFlag.Invisible, true);\r\n        handleEnemyAI();\r\n    }\r\n}\r\n\r\nfunction handlePlayerAttack() {\r\n    activeBattle = false;\r\n    battleCursor.setFlag(SpriteFlag.Invisible, true);\r\n\r\n    executeAttack(\"Hráč\", currentEnemy, true);\r\n    \r\n    if (currentEnemy.health <= 0) {\r\n        showBattleBanner(currentEnemy.name + \" poražen!\", 1000);\r\n        endBattle();\r\n        tiles.placeOnTile(player, tiles.getTileLocation(39, 14));\r\n        npc1.destroy();\r\n        npc1 = null;\r\n    } else {\r\n        startBattleTurn(\"Enemy\");\r\n    }\r\n}\r\n\r\nfunction handlePlayerHeal() {\r\n    activeBattle = false;\r\n    battleCursor.setFlag(SpriteFlag.Invisible, true);\r\n    \r\n    executeHeal(\"Hráč\", monsterArray[0]);\r\n    \r\n    updateBattleHealthBars();\r\n    \r\n    pause(600);\r\n    \r\n    startBattleTurn(\"Enemy\");\r\n}\r\n\r\nfunction handlePlayerRun() {\r\n    let coinflip = randint(1, 2);\r\n    if (coinflip === 1) {\r\n        showBattleBanner(\"Utekl jsi z boje\", 700);\r\n        endBattle();\r\n        tiles.placeOnTile(player, tiles.getTileLocation(39, 14));\r\n    } else {\r\n        showBattleBanner(\"Nepovedl se ti útěk\", 1000);\r\n        handleEnemyAI();\r\n    }\r\n}\r\n\r\nfunction handleEnemyAI() {\r\n    pause(800);\r\n    \r\n    if (currentEnemy.health < currentEnemy.maxHealth * 0.25 && randint(1, 3) === 1) {\r\n        executeHeal(currentEnemy.name, currentEnemy);\r\n    } else if (currentEnemy.health < currentEnemy.maxHealth * 0.5 && randint(1, 5) === 1) {\r\n        executeHeal(currentEnemy.name, currentEnemy);\r\n    } else {\r\n        executeAttack(currentEnemy.name, monsterArray[0], false);\r\n    }\r\n\r\n    if (monsterArray[0].health <= 0) {\r\n        showBattleBanner(\"Byl jsi poražen\", 2000);\r\n        endBattle();\r\n        tiles.setCurrentTilemap(assets.tilemap`hospital`);\r\n        tiles.placeOnTile(player, tiles.getTileLocation(3, 14));\r\n        healer = sprites.create(assets.image`healer`, SpriteKind.Enemy);\r\n        tiles.placeOnTile(healer, tiles.getTileLocation(11, 7));\r\n    } else {\r\n        startBattleTurn(\"Player\");\r\n    }\r\n}\r\n\r\nconst bigButtonAnimation = [\r\n    assets.image`bigButtonPress0`,\r\n    assets.image`bigButtonPress1`\r\n]\r\n\r\nconst animationWalk = [\r\n    assets.image`playerModel`,\r\n    assets.image`modelWalkFront2`,\r\n    assets.image`playerModel`,\r\n    assets.image`modelWalkFront4`,\r\n]\r\n\r\nconst animationWalkBack = [\r\n    assets.image`modelWalkBack1`,\r\n    assets.image`modelWalkBack2`,\r\n    assets.image`modelWalkBack1`,\r\n    assets.image`modelWalkBack4`,\r\n]\r\n\r\nconst animationWalkLeft = [\r\n    assets.image`modelWalkSideLeft1`,\r\n    assets.image`modelWalkSideLeft2`,\r\n    assets.image`modelWalkSideLeft1`,\r\n    assets.image`modelWalkSideLeft4`,\r\n]\r\n\r\nconst animationWalkRight = [\r\n    assets.image`modelWalkSideRight1`,\r\n    assets.image`modelWalkSideRight2`,\r\n    assets.image`modelWalkSideRight1`,\r\n    assets.image`modelWalkSideRight4`,\r\n]\r\n\r\n\r\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Enemy, function(player, otherSpr