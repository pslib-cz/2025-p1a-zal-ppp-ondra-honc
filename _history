 healer = sprites.create(assets.image`healer`, SpriteKind.Enemy);\r\n        tiles.setCurrentTilemap(tilemap`hospital`);\r\n        tiles.placeOnTile(player, tiles.getTileLocation(2,7));\r\n        tiles.placeOnTile(healer, tiles.getTileLocation(11, 7));\r\n        color.startFade(color.Black, color.originalPalette, 500);\r\n    }\r\n}\r\n\r\nfunction toggleMenu() {\r\n    if (inventory === null) {\r\n        controller.moveSprite(player, 0, 0);\r\n        inventory = sprites.create(assets.image`inventory`, SpriteKind.Menu);\r\n        inventory.setFlag(SpriteFlag.RelativeToCamera, true);\r\n        inventory.setPosition(80, 60);\r\n        inventory.z = 100;\r\n\r\n        for (let i: number = 0; i < monsterArray.length; i++) {\r\n            let sprite = sprites.create(monsterArray[i].icon, SpriteKind.MenuIcon);\r\n            sprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n            sprite.z = 101;\r\n            let offset = (monsterArray.length - 1) / 2;\r\n            sprite.setPosition(80 + (i - offset) * 40, 40);\r\n            \r\n            \r\n            let color = 2; //Red\r\n            let bar = image.create(24,5);\r\n            let lengthOfHealth = (monsterArray[i].health / monsterArray[i].maxHealth) * 22;\r\n            if (monsterArray[i].health > monsterArray[i].maxHealth / 2) color = 7; //Green\r\n            bar.fill(15);\r\n            bar.fillRect(1, 1, lengthOfHealth, 3, color);\r\n            let healthSprite = sprites.create(bar, SpriteKind.MenuHP);\r\n            healthSprite.z = 102;\r\n            healthSprite.setPosition(sprite.x, sprite.y + 15);\r\n            healthSprite.setFlag(SpriteFlag.RelativeToCamera, true)\r\n\r\n            \r\n            let name = image.create(50,8);\r\n            name.print(monsterArray[i].name, 0, 0, 15);\r\n            let nameSpi\r\n        }\r\n\r\n    } else {\r\n        inventory.destroy();\r\n        sprites.destroyAllSpritesOfKind(SpriteKind.MenuIcon);\r\n        sprites.destroyAllSpritesOfKind(SpriteKind.MenuHP);\r\n        inventory = null;\r\n        controller.moveSprite(player, 100, 100);\r\n    }\r\n}\r\n\r\nconst bigButtonAnimation = [\r\n    assets.image`bigButtonPress0`,\r\n    assets.image`bigButtonPress1`\r\n]\r\n\r\nconst animationWalk = [\r\n    assets.image`playerModel`,\r\n    assets.image`modelWalkFront2`,\r\n    assets.image`playerModel`,\r\n    assets.image`modelWalkFront4`,\r\n]\r\n\r\nconst animationWalkBack = [\r\n    assets.image`modelWalkBack1`,\r\n    assets.image`modelWalkBack2`,\r\n    assets.image`modelWalkBack1`,\r\n    assets.image`modelWalkBack4`,\r\n]\r\n\r\nconst animationWalkLeft = [\r\n    assets.image`modelWalkSideLeft1`,\r\n    assets.image`modelWalkSideLeft2`,\r\n    assets.image`modelWalkSideLeft1`,\r\n    assets.image`modelWalkSideLeft4`,\r\n]\r\n\r\nconst animationWalkRight = [\r\n    assets.image`modelWalkSideRight1`,\r\n    assets.image`modelWalkSideRight2`,\r\n    assets.image`modelWalkSideRight1`,\r\n    assets.image`modelWalkSideRight4`,\r\n]\r\n\r\nanimation.runImageAnimation(bigButton, bigButtonAnimation, 500, true);\r\n\r\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Enemy, function(player, otherSprite) {\r\n    if (!speaking) {\r\n        speaking = true;\r\n        if (otherSprite == npc1) {\r\n            game.showLongText(\"test npc1\", DialogLayout.Bottom);\r\n        } else if (otherSprite == npc2) {\r\n            game.showLongText(\"test npc2\", DialogLayout.Bottom);\r\n        }\r\n        pause(1000);\r\n        speaking = false;\r\n    }\r\n})\r\n\r\nscene.onOverlapTile(SpriteKind.Player, sprites.dungeon.doorClosedEast, function(player, location) {\r\n    teleport(location);\r\n})\r\n\r\nscene.onOverlapTile(SpriteKind.Player, sprites.dungeon.collectibleInsignia, function(player, location) {\r\n    color.startFade(color.originalPalette, color.Black, 500);\r\n    tiles.setCurrentTilemap(tilemap`mainLocation`);\r\n    tiles.placeOnTile(player, tiles.getTileLocation(33, 7));\r\n    color.startFade(color.Black, color.originalPalette, 500);\r\n})\r\n\r\ngame.onUpdate(function() {\r\n    if (!inventoryOpen) {\r\n        if (gamePlay) {\r\n            if (player.vx < 0) {\r\n                if (playerDirection !== \"left\") {\r\n                    playerDirection = \"left\";\r\n                    animation.runImageAnimation(player, animationWalkLeft, 200, true);\r\n                }\r\n            }\r\n            else if (player.vx > 0) {\r\n                if (playerDirection !== \"right\") {\r\n                    playerDirection = \"right\";\r\n                    animation.runImageAnimation(player, animationWalkRight, 200, true);\r\n                }\r\n            }\r\n            else if (player.vy > 0) {\r\n                if (playerDirection !== \"down\") {\r\n                    playerDirection = \"down\";\r\n                    animation.runImageAnimation(player, animationWalk, 200, true);\r\n                }\r\n            }\r\n            else if (player.vy < 0) {\r\n                if (playerDirection !== \"up\") {\r\n                    playerDirection = \"up\";\r\n                    animation.runImageAnimation(player, animationWalkBack, 200, true);\r\n                }\r\n            }\r\n            else {\r\n                if (playerDirection !== \"none\") {\r\n                    playerDirection = \"none\";\r\n                    animation.stopAnimation(animation.AnimationTypes.All, player);\r\n                }\r\n            }\r\n        }\r\n    }\r\n})\r\n\r\ncontroller.A.onEvent(ControllerButtonEvent.Pressed, function() {\r\n    bigButton.destroy();\r\n    startGame();\r\n})\r\n\r\ncontroller.B.onEvent(ControllerButtonEvent.Pressed, function() {\r\n    if(gamePlay) toggleMenu();\r\n})","README.md":" ","assets.json":"","images.g.jres":"{\n    \"image1\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAPAPAAAAAPD///7gRAAA/+/v7k9NAPD/Lv/k/v8A8O/yv9EuQv//4vL+3yRC/y/i8k7dJFIPL+LyTt0kUg//4vL+3yRC//Dv8r/RLkL/8P8u/+T+/wAA/+7v7k9NAADw