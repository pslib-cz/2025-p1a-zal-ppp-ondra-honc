     \"displayName\": \"world\"\n    },\n    \"image35\": {\n        \"data\": \"\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"fightMenu\"\n    },\n    \"image36\": {\n        \"data\": \"\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"dialogFightBox\"\n    },\n    \"image34\": {\n        \"data\": \"\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"playerStatusBox\"\n    },\n    \"image33\": {\n        \"data\": \"\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"displayName\": \"enemyStatusBox\"\n    },\n    \"*\": {\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"dataEncoding\": \"base64\",\n        \"namespace\": \"myImages\"\n    }\n}","images.g.ts":"","tilemap.g.jres":"{\n    \"transparency16\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true\n    },\n    \"hospital1\": {\n        \"id\": \"hospital1\",\n        \"mimeType\": \"application/mkcd-tilemap\",\n        \"data\": \"\",\n        \"tileset\": [\n            \"myTiles.transparency16\",\n            \"sprites.dungeon.darkGroundCenter\",\n            \"sprites.dungeon.darkGroundNorthEast0\",\n            \"sprites.dungeon.darkGroundSouth\",\n            \"sprites.dungeon.darkGroundEast\",\n            \"sprites.dungeon.darkGroundNorth\",\n            \"sprites.dungeon.darkGroundWest\",\n            \"sprites.dungeon.darkGroundSouthEast0\",\n            \"sprites.swamp.swampTile9\",\n            \"sprites.dungeon.collectibleInsignia\"\n        ],\n        \"displayName\": \"hospital\"\n    },\n    \"mainLocation1\": {\n        \"id\": \"mainLocation1\",\n        \"mimeType\": \"application/mkcd-tilemap\",\n        \"data\": \"\",\n        \"tileset\": [\n            \"myTil