\r\n                handlePlayerAttack();\r\n                break;\r\n\r\n            case FightMode.Heal:\r\n                handlePlayerHeal();\r\n                break;\r\n\r\n            case FightMode.Run:\r\n                handlePlayerRun();\r\n                break;\r\n        }\r\n    }\r\n})\r\n\r\ncontroller.B.onEvent(ControllerButtonEvent.Pressed, function () {\r\n    if (GameState.bestiaryOpen) {\r\n        closeBestiary();\r\n        return;\r\n    }\r\n\r\n    if (GameState.speaking) return;\r\n\r\n    if (GameState.inventoryOpen) {\r\n        toggleMenu();\r\n    } else if (GameState.gamePlay) {\r\n        toggleMenu();\r\n    }\r\n})\r\n\r\ncontroller.up.onEvent(ControllerButtonEvent.Pressed, function () {\r\n    if (GameState.activeBattle) {\r\n        if (activeBattleChoice === FightMode.Run) {\r\n            activeBattleChoice = FightMode.Fight;\r\n            updateCursorDisplay();\r\n        }\r\n    }\r\n})\r\n\r\ncontroller.down.onEvent(ControllerButtonEvent.Pressed, function () {\r\n    if (GameState.activeBattle) {\r\n        if (activeBattleChoice === FightMode.Fight) {\r\n            activeBattleChoice = FightMode.Run;\r\n            updateCursorDisplay();\r\n        }\r\n    }\r\n})\r\n\r\ncontroller.right.onEvent(ControllerButtonEvent.Pressed, function () {\r\n    if (GameState.activeBattle) {\r\n        if (activeBattleChoice === FightMode.Fight) {\r\n            activeBattleChoice = FightMode.Heal;\r\n            updateCursorDisplay();\r\n        }\r\n    }\r\n})\r\n\r\ncontroller.left.onEvent(ControllerButtonEvent.Pressed, function () {\r\n    if (GameState.activeBattle) {\r\n        if (activeBattleChoice === FightMode.Heal) {\r\n            activeBattleChoice = FightMode.Fight;\r\n            updateCursorDisplay();\r\n        }\r\n    }\r\n})\r\n\r\ncontroller.menu.onEvent(ControllerButtonEvent.Pressed, function () {\r\n    if (!GameState.gamePlay || GameState.activeBattle || GameState.speaking) return;\r\n    saveGame();\r\n    s