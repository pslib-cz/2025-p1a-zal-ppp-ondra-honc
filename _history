shark`,\r\n]\r\n\r\nconst miniGodzillaAttack: Image[] = [\r\n    assets.image`miniGodzilla`,\r\n    assets.image`kaijuMomAttack2`,\r\n    assets.image`kaijuMomAttack4`,\r\n    assets.image`miniGodzilla`,\r\n]\r\n\r\nconst clamAttack: Image[] = [\r\n    assets.image`clam`,\r\n    assets.image`clam2`,\r\n    assets.image`clam0`,\r\n    assets.image`clam`,\r\n]\r\n\r\nconst magicFishAttack: Image[] = [\r\n    assets.image`magiTang`,\r\n    assets.image`magiTang1`,\r\n    assets.image`magiTang2`,\r\n    assets.image`magiTang`,\r\n]\r\n\r\nconst monkeyAttack: Image[] = [\r\n    assets.image`forestMonkey`,\r\n    assets.image`forestMonkey6`,\r\n    assets.image`forestMonkey7`,\r\n    assets.image`forestMonkey10`,\r\n    assets.image`forestMonkey`,\r\n]\r\n\r\nconst snakeAttack: Image[] = [\r\n    assets.image`forestSnake`,\r\n    assets.image`forestSnake4`,\r\n    assets.image`forestSnake5`,\r\n    assets.image`forestSnake`,\r\n]\r\n\r\nconst crabAttack: Image[] = [\r\n    assets.image`hermitCrab`,\r\n    assets.image`hermitCrabAttack0`,\r\n    assets.image`hermitCrabAttack3`,\r\n    assets.image`hermitCrabAttack5`,\r\n    assets.image`hermitCrab`,\r\n]\r\n\r\nconst godzillaAttack: Image[] = [\r\n    assets.image`godzilla`,\r\n    godzilla1,\r\n    godzilla2,\r\n    assets.image`godzilla`,\r\n]\r\n\r\nconst attackAnims: { [key: string]: Image[] } = {\r\n    \"Opice\": monkeyAttack,\r\n    \"Had\": snakeAttack,\r\n    \"Krab\": crabAttack,\r\n    \"Zub\": sharkAttack,\r\n    \"Kačka\": duckAttack,\r\n    \"Upír\": batAttack,\r\n    \"Zilka\": miniGodzillaAttack,\r\n    \"Mlž\": clamAttack,\r\n    \"Mag\": magicFishAttack,\r\n    \"Godzilla\": godzillaAttack,    \r\n};\r\n\r\nfunction getAttackAnim(monster: Monster): Image[] {\r\n    if (attackAnims[monster.name]) {\r\n        return attackAnims[monster.name];\r\n    }\r\n\r\n    return [monster.icon];\r\n}\r\n\r\nfunction showIntro(): void {\r\n    GameState.gamePlay = false;\r\n\r\n    color.startFade(color.originalPalette, color.White, 200);\r\n    pause(UI_CONFIG.INTRO_PAUSE);\r\n    color.startFade(color.White, color.originalPalette, 1000);\r\n    scene.setBackgroundImage(null);\r\n\r\n    scene.setBackgroundColor(COLORS.BLACK);\r\n\r\n    pause(UI_CONFIG.INTRO_PAUSE);\r\n    story.printCharacterText(\"Svět, jak jsi ho znal, utichl...\");\r\n    story.printCharacterText(\"V hlubokých lesech se probudila prastará stvoření.\");\r\n    story.printCharacterText(\"Tvé dobrodružství začíná právě teď!\");\r\n\r\n    startGame();\r\n}\r\n\r\nfunction createTextSprite(text: string, width: number, height: number, x: number, y: number, kind: number, z: number): Sprite {\r\n    let name = image.create(width, height);\r\n    let textX = (width - (text.length * 6)) / 2;\r\n\r\n    name.print(text, textX, 0, 15);\r\n\r\n    let textSprite = sprites.create(name, kind);\r\n    textSprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    textSprite.z = z;\r\n\r\n    textSprite.setPosition(x, y);\r\n\r\n    return textSprite;\r\n}\r\n\r\nfunction createUISprite(img: Image, x: number, y: number): Sprite {\r\n    let sprite = sprites.create(img, SpriteKind.UI);\r\n    sprite.setPosition(x, y);\r\n    sprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    sprite.z = 20;\r\n    return sprite;\r\n}\r\n\r\nfunction saveMonsterGroup(monsters: Monster[], prefix: string): void {\r\n    let health: number[] = [];\r\n    let maxHealth: number[] = [];\r\n    let xp: number[] = [];\r\n    let maxXp: number[] = [];\r\n    let level: number[] = [];\r\n    let minDmg: number[] = [];\r\n    let maxDmg: number[] = [];\r\n    let names: string[] = [];\r\n\r\n    for (let monster of monsters) {\r\n        names.push(monster.name);\r\n        health.push(monster.health);\r\n        maxHealth.push(monster.maxHealth);\r\n        xp.push(monster.xp);\r\n        maxXp.push(monster.maxXp);\r\n        level.push(monster.level);\r\n        minDmg.push(monster.minDmg);\r\n        maxDmg.push(monster.maxDmg);\r\n    }\r\n\r\n    settings.writeString(prefix + \"_names\", names.join(\",\"));\r\n    settings.writeNumberArray(prefix + \"_health\", health);\r\n    settings.writeNumberArray(prefix + \"_maxHealth\", maxHealth);\r\n    settings.writeNumberArray(prefix + \"_xp\", xp);\r\n    settings.writeNumberArray(prefix + \"_maxXp\", maxXp);\r\n    settings.writeNumberArray(prefix + \"_level\", level);\r\n    settings.writeNumberArray(prefix + \"_minDmg\", minDmg);\r\n    settings.writeNumberArray(prefix + \"_maxDmg\", maxDmg);\r\n}\r\n\r\nfunction loadMonsterGroup(prefix: string): Monster[] {\r\n    let namesStr = settings.readString(prefix + \"_names\");\r\n    if (namesStr.length === 0) return [];\r\n\r\n    let names = namesStr.split(\",\");\r\n    let health = settings.readNumberArray(prefix + \"_health\");\r\n    let maxHealth = settings.readNumberArray(prefix + \"_maxHealth\");\r\n    let xp = settings.readNumberArray(prefix + \"_xp\");\r\n    let maxXp = settings.readNumberArray(prefix + \"_maxXp\");\r\n    let level = settings.readNumberArray(prefix + \"_level\");\r\n    let minDmg = settings.readNumberArray(prefix + \"_minDmg\");\r\n    let maxDmg = settings.readNumberArray(prefix + \"_maxDmg\");\r\n\r\n    let result: Monster[] = [];\r\n    for (let i = 0; i < names.length; i++) {\r\n        let base = BASE_MONSTERS.find(m => m.name === names[i]);\r\n        result.push({\r\n            name: names[i],\r\n            health: health[i],\r\n            maxHealth: maxHealth[i],\r\n            xp: xp[i],\r\n            maxXp: maxXp[i],\r\n            level: level[i],\r\n            minDmg: minDmg[i],\r\n            maxDmg: maxDmg[i],\r\n            icon: base.icon,\r\n            gender: base.gender,\r\n        });\r\n    }\r\n    return result;\r\n}\r\n\r\nfunction saveGame(): void {\r\n    saveMonsterGroup(monsterArray, \"m\");\r\n    saveMonsterGroup(deadPlayerMonsters, \"dead\");\r\n    settings.writeNumber(\"TLAS\", GameState.timesLookedAtSign);\r\n    settings.writeNumber(\"pX\", GameActors.player.x);\r\n    settings.writeNumber(\"pY\", GameActors.player.y);\r\n    settings.writeString(\"defeated\", defeatedMonsters.join(\",\"));\r\n}\r\n\r\nfunction loadGame(): void {\r\n    if (!settings.exists(\"m_names\")) return;\r\n\r\n    let loaded = loadMonsterGroup(\"m\");\r\n    while (monsterArray.length > loaded.length) monsterArray.shift();\r\n    for (let i = 0; i < monsterArray.length; i++) {\r\n        monsterArray[i].health = loaded[i].health;\r\n        monsterArray[i].maxHealth = loaded[i].maxHealth;\r\n        monsterArray[i].xp = loaded[i].xp;\r\n        monsterArray[i].maxXp = loaded[i].maxXp;\r\n        monsterArray[i].level = loaded[i].level;\r\n        monsterArray[i].minDmg = loaded[i].minDmg;\r\n        monsterArray[i].maxDmg = loaded[i].maxDmg;\r\n    }\r\n\r\n    deadPlayerMonsters = loadMonsterGroup(\"dead\");\r\n\r\n    let joinedDefeated = settings.readString(\"defeated\");\r\n    if (joinedDefeated.length > 0) defeatedMonsters = joinedDefeated.split(\",\");\r\n\r\n    GameState.timesLookedAtSign = settings.readNumber(\"TLAS\");\r\n    GameActors.player.setPosition(settings.readNumber(\"pX\"), settings.readNumber(\"pY\"));\r\n    showBattleBanner(\"Hra načtena!\", UI_CONFIG.BASIC_PAUSE * 2);\r\n}\r\n\r\nfunction createHealthBarSprite(current: number, max: number, width: number, height: number, x: number, y: number, kind: number, z: number): Sprite {\r\n    let bar = image.create(width, height);\r\n    bar.fill(COLORS.BLACK);\r\n\r\n    let currentWidth = Math.constrain((current / max) * (width - 2), 0, width - 2);\r\n\r\n    let color = COLORS.GREEN;\r\n    if (current < max * BALANCE_CONFIG.LOW_HEALTH_THRESHOLD) color = COLORS.RED;\r\n    else if (current < max * BALANCE_CONFIG.MID_HEALTH_THRESHOLD) color = COLORS.YELLOW;\r\n\r\n    if (currentWidth > 0) bar.fillRect(1, 1, currentWidth, height - 2, color);\r\n\r\n    let barSprite = sprites.create(bar, kind);\r\n    barSprite.setPosition(x, y);\r\n    barSprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    barSprite.z = z;\r\n\r\n    return barSprite;\r\n}\r\n\r\nfunction getAdjective(gender: string): string {\r\n    if (gender === \"M\") return \"Divoký\";\r\n    if (gender === \"F\") return \"Divoká\";\r\n    if (gender === \"N\") return \"Divoké\";\r\n    return \"Divoký\"\r\n}\r\n\r\nfunction updateCursorDisplay(): void {\r\n    let boxLeft = UI_CONFIG.CURSOR_POS_X;\r\n    let boxTop = UI_CONFIG.CURSOR_POS_Y;\r\n\r\n    let x = 0;\r\n    let y = 0;\r\n\r\n    if (activeBattleChoice === FightMode.Fight) {\r\n        UIComponents.battleCursor.setImage(assets.image`battleCursor`);\r\n        x = boxLeft + UI_CONFIG.CURSOR_FIGHT_POS_X;\r\n        y = boxTop + UI_CONFIG.CURSOR_FIGHT_POS_Y;\r\n    } else if (activeBattleChoice === FightMode.Run) {\r\n        UIComponents.battleCursor.setImage(assets.image`battleCursor`);\r\n        x = boxLeft + UI_CONFIG.CURSOR_RUN_POS_X;\r\n        y = boxTop + UI_CONFIG.CURSOR_RUN_POS_Y;\r\n    } else if (activeBattleChoice === FightMode.Heal) {\r\n        UIComponents.battleCursor.setImage(assets.image`battleCursorFlipped`);\r\n        x = boxLeft + UI_CONFIG.CURSOR_HEAL_POS_X;\r\n        y = boxTop + UI_CONFIG.CURSOR_HEAL_POS_Y;\r\n    }\r\n\r\n    UIComponents.battleCursor.setPosition(x, y);\r\n    UIComponents.battleCursor.z = 25;\r\n}\r\n\r\nfunction showBattleBanner(text: string, duration: number): void {\r\n    let bannerImg = image.create(160, 20);\r\n    bannerImg.fill(15);\r\n\r\n    let textX = (160 - (text.length * 6)) / 2;\r\n    bannerImg.print(text, textX, 6, 1);\r\n\r\n    let banner = sprites.create(bannerImg, SpriteKind.UI);\r\n    banner.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    banner.z = 200;\r\n    banner.setPosition(80, 60);\r\n\r\n    banner.x = 240;\r\n    banner.vx = -600;\r\n    pause(UI_CONFIG.ANIMATION_SLIDE_PAUSE);\r\n    banner.vx = 0;\r\n    banner.x = 80;\r\n\r\n    pause(duration);\r\n    banner.destroy();\r\n}\r\n\r\nfunction placeAt(sprite: Sprite, location: number[]): void {\r\n    const [col, row] = location;\r\n    tiles.placeOnTile(sprite, tiles.getTileLocation(col, row));\r\n}\r\n\r\nfunction startGame(): void {\r\n    if (!GameState.gamePlay) {\r\n        color.startFade(color.Black, color.originalPalette, 1000);\r\n        tiles.setCurrentTilemap(tilemap`mainLocation`);\r\n        GameActors.player = sprites.create(assets.image`playerModel`, SpriteKind.Player);\r\n        controller.moveSprite(GameActors.player);\r\n        scene.cameraFollowSprite(GameActors.player);\r\n\r\n        GameActors.npc1 = sprites.create(assets.image`npc1`, SpriteKind.Enemy);\r\n        placeAt(GameActors.npc1, LOCATIONS.NPC1_LOCATION);\r\n\r\n        GameActors.bossfight = sprites.create(assets.image`npc2`, SpriteKind.Enemy);\r\n        placeAt(GameActors.bossfight, LOCATIONS.BOSSFIGHT_LOCATION);\r\n\r\n\r\n        GameActors.townKeeper = sprites.create(assets.image`townKeeper`, SpriteKind.Enemy);\r\n        placeAt(GameActors.townKeeper, LOCATIONS.TOWNKEEPER_LOCATION);\r\n\r\n\r\n        GameState.gamePlay = true;\r\n    }\r\n}\r\n\r\nfunction checkLevelUp(monster: Monster): void {\r\n    if (monster.xp >= monster.maxXp) {\r\n        monster.level += 1;\r\n        monster.xp -= monster.maxXp;\r\n        monster.health = monster.maxHealth;\r\n       \r\n        monster.maxXp = Math.floor(monster.maxXp * BALANCE_CONFIG.XP_SCALE);\r\n        monster.maxHealth = Math.floor(monster.maxHealth * BALANCE_CONFIG.HP_DMG_SCALE);\r\n        monster.minDmg = Math.floor(monster.minDmg * BALANCE_CONFIG.HP_DMG_SCALE);\r\n        monster.maxDmg = Math.floor(monster.maxDmg * BALANCE_CONFIG.HP_DMG_SCALE);\r\n\r\n        saveGame();\r\n        showBattleBanner(monster.name + \" postoupil na lvl \" + monster.level + \"!\", 1500);\r\n    }\r\n}\r\n\r\nfunction writeSmallFont(text: string, x: number, y: number, z: number, kind: number): Sprite {\r\n    let sprite = textsprite.create(text, 0, 15);\r\n\r\n    sprite.setMaxFontHeight(5);\r\n    sprite.setKind(kind);\r\n    sprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    sprite.z = z;\r\n    sprite.setPosition(x, y);\r\n\r\n    return sprite;\r\n}\r\n\r\nfunction teleport(location: tiles.Location) {\r\n    let x = location.column;\r\n    let y = location.row;\r\n\r\n    if (x === LOCATIONS.HOSPITAL_DOOR_COL && (y >= LOCATIONS.HOSPITAL_DOOR_ROW[0] && y <= LOCATIONS.HOSPITAL_DOOR_ROW[1])) {\r\n        color.startFade(color.originalPalette, color.Black, 500);\r\n        if (GameActors.healer) GameActors.healer.destroy();\r\n        GameActors.healer = sprites.create(assets.image`healer`, SpriteKind.Enemy);\r\n        tiles.setCurrentTilemap(tilemap`hospital`);\r\n        placeAt(GameActors.player, LOCATIONS.PLAYER_IN_HOSPITAL);\r\n        placeAt(GameActors.healer, LOCATIONS.HEALER_LOCATION);\r\n        color.startFade(color.Black, color.originalPalette, 500);\r\n    }\r\n}\r\n\r\nfunction createSilhouette(original: Image): Image {\r\n    let silhouette = original.clone();\r\n\r\n    for (let i: number = 1; i <= 15; i++) {\r\n        silhouette.replace(i, COLORS.BLACK);\r\n    }\r\n\r\n    return silhouette;\r\n}\r\n\r\nfunction toggleBestiary(): void {\r\n    GameState.gamePlay = false;\r\n    controller.moveSprite(GameActors.player, 0, 0);\r\n    GameActors.player.setFlag(SpriteFlag.Ghost, true);\r\n\r\n    const bg = sprites.create(assets.image`inventory`, SpriteKind.UI);\r\n    bg.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    bg.setPosition(80, 60);\r\n    bg.z = 200;\r\n\r\n    const startX = 45;\r\n    const startY = 45;\r\n    const gapX = 35;\r\n    const gapY = 30;\r\n\r\n    let sortedMonsters = wildMonsters.slice().sort((a, b) => {\r\n        if (a.name < b.name) return -1;\r\n        if (a.name > b.name) return 1;\r\n        return 0;\r\n    });\r\n\r\n    for (let i = 0; i < sortedMonsters.length; i++) {\r\n        let currentData = sortedMonsters[i];\r\n\r\n        let col = i % 3;\r\n        let row = Math.floor(i / 3);\r\n        let posX = startX + (col * gapX);\r\n        let posY = startY + (row * gapY);\r\n\r\n        let isDefeated = defeatedMonsters.indexOf(currentData.name) !== -1;\r\n\r\n        let finalIcon: Image;\r\n        let displayName: string;\r\n\r\n        if (isDefeated) {\r\n            finalIcon = currentData.icon;\r\n            displayName = currentData.name;\r\n        } else {\r\n            finalIcon = createSilhouette(currentData.icon);\r\n            displayName = \"???\";\r\n        }\r\n        let iconSprite = sprites.create(finalIcon, SpriteKind.UIIcon);\r\n        iconSprite.setPosition(posX, posY);\r\n        iconSprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n        iconSprite.z = 201;\r\n\r\n        writeSmallFont(displayName, posX, posY - 15, 202, SpriteKind.UIText);\r\n    }\r\n}\r\n\r\nfunction closeBestiary(): void {\r\n    sprites.destroyAllSpritesOfKind(SpriteKind.UIText);\r\n    sprites.destroyAllSpritesOfKind(SpriteKind.UIIcon);\r\n    sprites.destroyAllSpritesOfKind(SpriteKind.UI);\r\n\r\n    GameState.gamePlay = true;\r\n    GameState.bestiaryOpen = false;\r\n\r\n    finishTalking();\r\n    controller.moveSprite(GameActors.player, 100, 100);\r\n    GameActors.player.setFlag(SpriteFlag.Ghost, false);\r\n}\r\n\r\nfunction toggleMenu(): void {\r\n    if (UIComponents.inventory === null) {\r\n        if (GameState.speaking || GameState.activeBattle) return;\r\n        GameState.inventoryOpen = true;\r\n        controller.moveSprite(GameActors.player, 0, 0);\r\n        UIComponents.inventory = sprites.create(assets.image`inventory`, SpriteKind.UI);\r\n        UIComponents.inventory.setFlag(SpriteFlag.RelativeToCamera, true);\r\n        UIComponents.inventory.setPosition(80, 60);\r\n        UIComponents.inventory.z = 100;\r\n\r\n        for (let i: number = 0; i < monsterArray.length; i++) {\r\n            let sprite = sprites.create(monsterArray[i].icon, SpriteKind.UIIcon);\r\n            let monster: Monster = monsterArray[i];\r\n            sprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n            sprite.z = 101;\r\n            let offset = (monsterArray.length - 1) / 2;\r\n            sprite.setPosition(79 + (i - offset) * 48, 40);\r\n\r\n            createHealthBarSprite(\r\n                monster.health,\r\n                monster.maxHealth,\r\n                24, 5, //Width, height\r\n                sprite.x,\r\n                sprite.y + 18,\r\n                SpriteKind.UIBar,\r\n                102 //Z index\r\n            );\r\n\r\n            createTextSprite(monster.name, 50, 8, sprite.x, sprite.y - 15, SpriteKind.UIText, 102);\r\n            writeSmallFont(monster.health + \"/\" + monster.maxHealth, sprite.x, sprite.y + 25, 102, SpriteKind.UIText);\r\n            writeSmallFont(monster.xp + \"/\" + monster.maxXp, sprite.x, sprite.y + 38, 102, SpriteKind.UIText);\r\n            writeSmallFont(monster.minDmg + \"-\" + monster.maxDmg, sprite.x, sprite.y + 46, 102, SpriteKind.UIText);\r\n\r\n            let xpBarImg = image.create(30, 3);\r\n            xpBarImg.fill(COLORS.BLACK);\r\n            let xpWidth = Math.constrain((monster.xp / monster.maxXp) * 28, 0, 28);\r\n            if (xpWidth > 0) xpBarImg.fillRect(1, 1, xpWidth, 3, COLORS.LIGHT_BLUE);\r\n            let xpBar = sprites.create(xpBarImg, SpriteKind.UIBar);\r\n            xpBar.setPosition(sprite.x, sprite.y + 32);\r\n            xpBar.setFlag(SpriteFlag.RelativeToCamera, true);\r\n            xpBar.z = 102;\r\n        }\r\n\r\n    } else {\r\n        UIComponents.inventory.destroy();\r\n        sprites.destroyAllSpritesOfKind(SpriteKind.UIIcon);\r\n        sprites.destroyAllSpritesOfKind(SpriteKind.UIBar);\r\n        sprites.destroyAllSpritesOfKind(SpriteKind.UIText);\r\n        UIComponents.inventory = null;\r\n        GameState.inventoryOpen = false;\r\n        controller.moveSprite(GameActors.player, 100, 100);\r\n    }\r\n}\r\n\r\nfunction updateStatus(isPlayer: boolean): void {\r\n    let monster = isPlayer ? monsterArray[0] : currentEnemy;\r\n    let box = isPlayer ? UIComponents.playerStatusBox : UIComponents.enemyStatusBox;\r\n\r\n    let barX = isPlayer ? box.x : box.x - 7;\r\n    let barY = box.y + 3;\r\n\r\n    if (isPlayer && UIComponents.playerNameSprite) UIComponents.playerNameSprite.destroy();\r\n    else if (!isPlayer && UIComponents.enemyNameSprite) UIComponents.enemyNameSprite.destroy();\r\n\r\n    if (isPlayer && UIComponents.playerHPBar) UIComponents.playerHPBar.destroy();\r\n    else if (!isPlayer && UIComponents.enemyHPBar) UIComponents.enemyHPBar.destroy();\r\n\r\n    let newName = createTextSprite(\r\n        monster.name, 50, 8, barX + (isPlayer ? 1 : 3), barY - 8, SpriteKind.UIText, 25\r\n    );\r\n\r\n    let newBar = createHealthBarSprite(\r\n        monster.health, monster.maxHealth, 35, 5, barX, barY, SpriteKind.UIBar, 25\r\n    );\r\n\r\n    if (isPlayer) {\r\n        UIComponents.playerNameSprite = newName;\r\n        UIComponents.playerHPBar = newBar;\r\n    } else {\r\n        UIComponents.enemyNameSprite = newName;\r\n        UIComponents.enemyHPBar = newBar;\r\n    }\r\n}\r\n\r\nfunction startFight(): void {\r\n    if (GameState.activeBattle) return;\r\n    GameState.activeBattle = true;\r\n    controller.moveSprite(GameActors.player, 0, 0);\r\n    if (GameActors.lastNpcEncountered === null) showBattleBanner(\"Divoké zvíře se přiblížilo!\", UI_CONFIG.BASIC_PAUSE * 3);\r\n    color.startFade(color.originalPalette, color.Black, 200);\r\n\r\n    GameActors.player.setFlag(SpriteFlag.Ghost, true);\r\n    scene.cameraFollowSprite(null);\r\n    scene.centerCameraAt(80, 60);\r\n\r\n    \r\n    let randomMonsterNumber = randint(0, wildMonsters.length - 1);\r\n    let randomBackgroundNumber = randint(0, backgrounds.length - 1);\r\n\r\n    GameActors.player.setFlag(SpriteFlag.Invisible, true);\r\n    tiles.setCurrentTilemap(null);\r\n    scene.setBackgroundImage(backgrounds[randomBackgroundNumber]);\r\n    currentEnemy = wildMonsters[randomMonsterNumber];\r\n    \r\n    if (GameActors.lastNpcEncountered === GameActors.bossfight) currentEnemy = bossFightLayup[0];\r\n    \r\n    currentEnemy.health = currentEnemy.maxHealth;\r\n\r\n    UIComponents.fightMenuBox = createUISprite(assets.image`fightMenu`, UI_CONFIG.FIGHT_MENU_POS_X, UI_CONFIG.FIGHT_MENU_POS_Y);\r\n    UIComponents.enemyStatusBox = createUISprite(assets.image`enemyStatusBox`, UI_CONFIG.ENEMY_STATUS_BOX_POS_X, UI_CONFIG.ENEMY_STATUS_BOX_POS_Y);\r\n    UIComponents.playerStatusBox = createUISprite(assets.image`playerStatusBox`, UI_CONFIG.PLAYER_STATUS_BOX_POS_X, UI_CONFIG.PLAYER_STATUS_BOX_POS_Y);\r\n\r\n    UIComponents.playerBattleSprite = sprites.create(monsterArray[0].icon, SpriteKind.BattleSprite);\r\n    UIComponents.enemyBattleSprite = sprites.create(currentEnemy.icon, SpriteKind.BattleSprite);\r\n\r\n    UIComponents.playerBattleSprite.setScale(2);\r\n    if (currentEnemy.name === \"Godzilla\") UIComponents.enemyBattleSprite.setScale(0.75);\r\n    else UIComponents.enemyBattleSprite.setScale(2);\r\n    \r\n    UIComponents.playerBattleSprite.setPosition(UI_CONFIG.PLAYER_POS_X, UI_CONFIG.PLAYER_POS_Y);\r\n    UIComponents.enemyBattleSprite.setPosition(UI_CONFIG.ENEMY_POS_X, UI_CONFIG.ENEMY_POS_Y);\r\n\r\n    UIComponents.playerBattleSprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    UIComponents.enemyBattleSprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n\r\n    UIComponents.playerBattleSprite.z = 10;\r\n    UIComponents.enemyBattleSprite.z = 10;\r\n\r\n    updateStatus(true);  // Aktualizuje hráče\r\n    updateStatus(false); // Aktualizuje nepřítele\r\n\r\n    UIComponents.battleCursor = sprites.create(assets.image`battleCursor`, SpriteKind.UI);\r\n    UIComponents.battleCursor.z = 100;\r\n    UIComponents.battleCursor.setFlag(SpriteFlag.RelativeToCamera, true);\r\n    updateCursorDisplay();\r\n\r\n    let adjective = getAdjective(currentEnemy.gender);\r\n    color.startFade(color.Black, color.originalPalette, 200);\r\n    story.printCharacterText(`${adjective} ${currentEnemy.name} útočí!`);\r\n    pause(UI_CONFIG.BASIC_PAUSE);\r\n\r\n    let coinflip = randint(1, 2);\r\n\r\n    if (coinflip === 1) {\r\n        showBattleBanner(\"Začínáš!\", 1500);\r\n        startBattleTurn(Turn.Player);\r\n    } else {\r\n        showBattleBanner(`${currentEnemy.name} začíná první!`, 1500);\r\n        startBattleTurn(Turn.Enemy);\r\n    }\r\n}\r\n\r\nfunction endBattle(): void {\r\n    GameState.activeBattle = false;\r\n    GameState.gamePlay = true;\r\n    GameState.speaking = false;\r\n\r\n    UIComponents.playerNameSprite = null;\r\n    UIComponents.enemyNameSprite = null;\r\n    UIComponents.playerHPBar = null;\r\n    UIComponents.enemyHPBar = null;\r\n\r\n    color.startFade(color.originalPalette, color.Black, 500);\r\n    pause(UI_CONFIG.BASIC_PAUSE);\r\n\r\n    sprites.destroyAllSpritesOfKind(SpriteKind.UI);\r\n    sprites.destroyAllSpritesOfKind(SpriteKind.UIBar);\r\n    sprites.destroyAllSpritesOfKind(SpriteKind.BattleSprite);\r\n    sprites.destroyAllSpritesOfKind(SpriteKind.UIText);\r\n\r\n    tiles.setCurrentTilemap(tilemap`mainLocation`);\r\n    GameActors.player.setFlag(SpriteFlag.Invisible, false);\r\n    scene.cameraFollowSprite(GameActors.player);\r\n\r\n    controller.moveSprite(GameActors.player, 100, 100);\r\n    GameActors.player.setFlag(SpriteFlag.Ghost, false);\r\n    color.startFade(color.Black, color.originalPalette, 500);\r\n}\r\n\r\nfunction executeAttack(attackerName: string, target: Monster, isPlayerAttacking: boolean): void {\r\n    showBattleBanner(attackerName + \" útočí!\", 1000);\r\n\r\n    let attacker: Monster = isPlayerAttacking ? monsterArray[0] : currentEnemy;\r\n\r\n    let damage = randint(attacker.minDmg, attacker.maxDmg);\r\n    let criticalDmg = randint(1, BALANCE_CONFIG.CRIT_CHANCE);\r\n    let criticalStrike: boolean = false;\r\n\r\n    let attackAnim = getAttackAnim(attacker);\r\n    let attackerSprite = isPlayerAttacking ? UIComponents.playerBattleSprite : UIComponents.enemyBattleSprite;\r\n    let moveOffset = isPlayerAttacking ? 10 : -10;\r\n\r\n    animation.runImageAnimation(attackerSprite, attackAnim, UI_CONFIG.ANIMATION_SPEED, false);\r\n    attackerSprite.x += moveOffset;\r\n    pause(attackAnim.length * 180);\r\n    attackerSprite.x -= moveOffset;\r\n\r\n    if (criticalDmg === 1) {\r\n        criticalStrike = true;\r\n        let critSprite = isPlayerAttacking\r\n            ? UIComponents.enemyBattleSprite\r\n            : UIComponents.playerBattleSprite;\r\n        critSprite.setFlag(SpriteFlag.RelativeToCamera, false);\r\n        scene.cameraShake(8, 500);\r\n        pause(UI_CONFIG.BASIC_PAUSE);\r\n        critSprite.setFlag(SpriteFlag.RelativeToCamera, true);\r\n        damage = Math.round((damage + BALANCE_CONFIG.CRIT_OFFSET) * BALANCE_CONFIG.CRIT_MULTIPLIER);\r\n    }\r\n\r\n    target.health -= damage;\r\n    if (target.health < target.maxHealth * UI_CONFIG.LOW_HP_CAMERA_THRESHOLD) {\r\n        scene.cameraShake(4, 500);\r\n    }\r\n\r\n    if (target.health < 0) target.health = 0;\r\n\r\n    if (isPlayerAttacking) {\r\n        UIComponents.enemyBattleSprite.setFlag(SpriteFlag.Invisible, true);\r\n        pause(UI_CONFIG.TOOK_DMG_PAUSE);\r\n        UIComponents.enemyBattleSprite.setFlag(SpriteFlag.Invisible, false);\r\n    } else {\r\n        UIComponents.playerBattleSprite.setFlag(SpriteFlag.Invisible, true);\r\n        pause(UI_CONFIG.TOOK_DMG_PAUSE);\r\n        UIComponents.playerBattleSprite.setFlag(SpriteFlag.Invisible, false);\r\n    }\r\n\r\n    updateStatus(true);  // Aktualizuje hráče\r\n    updateStatus(false); // Aktualizuje nepřítele\r\n\r\n    pause(2 * UI_CONFIG.TOOK_DMG_PAUSE);\r\n    !criticalStrike ? showBattleBanner(\"Ubráno \" + damage + \" HP\", 1000) : showBattleBanner(\"Kritický zásah za \" + damage + \" HP\", 1000)\r\n    pause(UI_CONFIG.BASIC_PAUSE);\r\n}\r\n\r\nfunction executeHeal(targetName: string, target: Monster): void {\r\n    let heal = randint(BALANCE_CONFIG.HEAL_MIN, BALANCE_CONFIG.HEAL_MAX);\r\n    let oldHealth = target.health;\r\n    target.health += heal;\r\n\r\n    if (target.health > target.maxHealth) {\r\n        target.health = target.maxHealth;\r\n    }\r\n\r\n    let actualHeal = target.health - oldHealth;\r\n\r\n    showBattleBanner(targetName + \" se léčí!\", 1000);\r\n\r\n    updateStatus(true);  // Aktualizuje hráče\r\n    updateStatus(false); // Aktualizuje nepřítele\r\n\r\n    if (actualHeal > 0) {\r\n        showBattleBanner(\"Obnoveno \" + actualHeal + \" HP\", 1000);\r\n    } else {\r\n        showBattleBanner(\"Zdraví je již plné!\", 1000);\r\n    }\r\n\r\n    pause(UI_CONFIG.BASIC_PAUSE);\r\n}\r\n\r\nfunction startBattleTurn(turn: Turn): void {\r\n    GameState.activeBattle = true;\r\n    if (turn === Turn.Player) {\r\n        pause(UI_CONFIG.RESET_GHOST_INPUT_PAUSE); //Resetting ghost inputs \r\n        GameState.isBusy = false;\r\n        playerTurnStartTime = game.runtime();\r\n        GameState.playerTurn = true;\r\n        UIComponents.battleCursor.setFlag(SpriteFlag.Invisible, false);\r\n    } else {\r\n        GameState.activeBattle = false;\r\n        GameState.playerTurn = false;\r\n        UIComponents.battleCursor.setFlag(SpriteFlag.Invisible, true);\r\n        handleEnemyAI();\r\n    }\r\n}\r\n\r\nfunction handlePlayerAttack(): void {\r\n    UIComponents.battleCursor.setFlag(SpriteFlag.Invisible, true);\r\n\r\n    executeAttack(\"Hráč\", currentEnemy, true);\r\n\r\n    if (currentEnemy.health <= 0) {\r\n        currentEnemy.gender === \"M\" ? showBattleBanner(currentEnemy.name + \" poražen!\", 1000) : showBattleBanner(currentEnemy.name + \" poražena!\", 1000)\r\n        let isQuest: boolean = (GameActors.lastNpcEncountered === GameActors.npc1);\r\n        \r\n        if (GameActors.lastNpcEncountered != null) {\r\n            let npcRow = GameActors.lastNpcEncountered.tilemapLocation().row;\r\n            let npcCol = GameActors.lastNpcEncountered.tilemapLocation().column;\r\n\r\n            GameActors.lastNpcEncountered.destroy();\r\n            GameActors.lastNpcEncountered = null;\r\n\r\n            tiles.placeOnTile(GameActors.player, tiles.getTileLocation(npcCol, npcRow + 1));\r\n        }\r\n\r\n        endBattle();\r\n\r\n        if (defeatedMonsters.indexOf(currentEnemy.name) === -1) {\r\n            defeatedMonsters.push(currentEnemy.name);\r\n            showBattleBanner(\"Nové zvíře objeveno: \" + currentEnemy.name, 2000);\r\n        }\r\n\r\n\r\n        let xpGain = randint(BALANCE_CONFIG.XP_MIN, BALANCE_CONFIG.XP_MAX);\r\n        \r\n        if (isQuest) xpGain *= BALANCE_CONFIG.QUEST_BONUS;\r\n        monsterArray[0].xp += xpGain;\r\n\r\n        showBattleBanner(\"Získáno \" + xpGain + \" XP\", 1000);\r\n        checkLevelUp(monsterArray[0]);\r\n\r\n    } else {\r\n        startBattleTurn(Turn.Enemy);\r\n    }\r\n}\r\n\r\nfunction handlePlayerHeal(): void {\r\n    UIComponents.battleCursor.setFlag(SpriteFlag.Invisible, true);\r\n\r\n    executeHeal(\"Hráč\", monsterArray[0]);\r\n\r\n    updateStatus(true);  // Aktualizuje hráče\r\n    updateStatus(false); // Aktualizuje nepřítele\r\n\r\n    pause(UI_CONFIG.BASIC_PAUSE);\r\n\r\n    startBattleTurn(Turn.Enemy);\r\n}\r\n\r\nfunction handlePlayerRun(): void {\r\n    let coinflip = randint(1, 2);\r\n    if (coinflip === 1) {\r\n        showBattleBanner(\"Utekl jsi!\", 1000);\r\n        endBattle();\r\n        if (GameActors.lastNpcEncountered != null) {\r\n            let npcRow = GameActors.lastNpcEncountered.tilemapLocation().row;\r\n            let npcCol = GameActors.lastNpcEncountered.tilemapLocation().column;\r\n\r\n            tiles.placeOnTile(GameActors.player, tiles.getTileLocation(npcCol, npcRow + 1));\r\n        }\r\n    } else {\r\n        showBattleBanner(\"Nepovedený útěk\", 1000);\r\n        handleEnemyAI();\r\n    }\r\n}\r\n\r\nfunction handleEnemyAI(): void {\r\n    pause(UI_CONFIG.AI_PAUSE);\r\n\r\n    if (currentEnemy.health < currentEnemy.maxHealth * BALANCE_CONFIG.LOW_HEALTH_THRESHOLD && randint(1, BALANCE_CONFIG.AI_HEAL_CHANCE_AT_LOW_HP) === 1) {\r\n        executeHeal(currentEnemy.name, currentEnemy);\r\n    } else if (currentEnemy.health < currentEnemy.maxHealth * BALANCE_CONFIG.MID_HEALTH_THRESHOLD && randint(1, BALANCE_CONFIG.AI_HEAL_CHANCE_AT_MID_HP) === 1) {\r\n        executeHeal(currentEnemy.name, currentEnemy);\r\n    } else {\r\n        executeAttack(currentEnemy.name, monsterArray[0], false);\r\n    }\r\n\r\n    if (monsterArray[0].health <= 0) {\r\n        monsterArray[0].gender === \"M\" ? showBattleBanner(monsterArray[0].name + \" je vyřazen!\", 1500) : showBattleBanner(monsterArray[0].name + \" je vyřazena!\", 1500)\r\n\r\n        monsterArray[0].xp *= BALANCE_CONFIG.XP_LOSS_ON_DEATH;\r\n        deadPlayerMonsters.push(monsterArray[0]);\r\n        monsterArray.shift();\r\n\r\n        if (monsterArray.length > 0) {\r\n            showBattleBanner(\"Nastupuje \" + monsterArray[0].name + \"!\", 1500);\r\n            UIComponents.playerBattleSprite.setImage(monsterArray[0].icon);\r\n            updateStatus(true);  // Aktualizuje hráče\r\n            updateStatus(false); // Aktualizuje nepřítele\r\n\r\n            startBattleTurn(Turn.Player);\r\n\r\n        } else {\r\n            showBattleBanner(\"Všechna zvířátka padla!\", 2000);\r\n\r\n            endBattle();\r\n\r\n            tiles.setCurrentTilemap(assets.tilemap`hospital`);\r\n            placeAt(GameActors.player, LOCATIONS.PLAYER_NEXT_TO_BED);\r\n            if (!GameActors.healer) GameActors.healer = sprites.create(assets.image`healer`, SpriteKind.Enemy);\r\n            placeAt(GameActors.healer, LOCATIONS.HEALER_LOCATION);\r\n        }\r\n    } else {\r\n        startBattleTurn(Turn.Player);\r\n    }\r\n}\r\n\r\n\r\n\r\nfunction finishTalking() {\r\n    if (GameActors.lastNpcEncountered) {\r\n        let diffX = GameActors.player.x - GameActors.lastNpcEncountered.x;\r\n        let diffY = GameActors.player.y - GameActors.lastNpcEncountered.y;\r\n\r\n        if (Math.abs(diffX) > Math.abs(diffY)) {\r\n            GameActors.player.x += (diffX > 0) ? 4 : -4;\r\n        } else {\r\n            GameActors.player.y += (diffY > 0) ? 4 : -4;\r\n        }\r\n    }\r\n\r\n    GameState.speaking = false;\r\n    controller.moveSprite(GameActors.player, 100, 100);\r\n}\r\n\r\nfunction handleGenericNPC(npc: Sprite): void {\r\n    if (npc === GameActors.npc1) {\r\n        story.printCharacterText(\"Chceš úkol?\", \"Potulník\");\r\n        story.showPlayerChoices(\"Ano\", \"Ne\");\r\n        if (story.checkLastAnswer(\"Ano\")) {\r\n            startFight();\r\n        } else {\r\n            story.printCharacterText(\"Tak se měj!\", \"Potulník\");\r\n        }\r\n    }\r\n    //Přidat další dialogy\r\n\r\n    if (!GameState.activeBattle) finishTalking();\r\n}\r\n\r\nfunction handleHealer(): void {\r\n    story.printCharacterText(\"Vyléčit/oživit zvířátka?\", \"Léčitel\");\r\n    story.showPlayerChoices(\"Vyléčit\", \"Oživit\");\r\n\r\n    if (story.checkLastAnswer(\"Vyléčit\")) {\r\n        for (let monster of monsterArray) {\r\n            monster.health = monster.maxHealth;\r\n        }\r\n        saveGame();\r\n        story.printCharacterText(\"Vyléčeno!\", \"Léčitel\");\r\n    }\r\n\r\n    if (story.checkLastAnswer(\"Oživit\")) {\r\n        if (deadPlayerMonsters.length === 0) {\r\n            story.printCharacterText(\"Nikdo není mrtvý!\", \"Léčitel\");\r\n        } else {                                          \r\n            for (let monster of deadPlayerMonsters) {\r\n                monster.health = 10;\r\n                monsterArray.push(monster);\r\n                story.printCharacterText(\"Oživeno: \" + monster.name, \"Léčitel\");\r\n            }\r\n            deadPlayerMonsters = [];\r\n            saveGame();\r\n        }\r\n    }\r\n\r\n    finishTalking();\r\n}\r\n\r\nfunction handleBestiary(): void {\r\n    story.printCharacterText(\"Zde je tvůj bestiář.\", \"Správce\");\r\n    GameState.bestiaryOpen = true;\r\n    toggleBestiary();\r\n}\r\n\r\nfunction handleBossfight(): void {\r\n    story.printCharacterText(\"Aby si dohrál hru, musíš porazit moje příšery\", \"???\");\r\n    story.showPlayerChoices(\"Jdu do toho!\", \"Přijdu později\");\r\n\r\n    if (story.checkLastAnswer(\"Jdu do toho!\")) startFight();\r\n\r\n    finishTalking();\r\n}\r\n\r\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Enemy, function (player, npc) {\r\n    if (GameState.speaking || GameState.activeBattle || GameState.inventoryOpen || GameState.bestiaryOpen) return;\r\n\r\n    GameActors.lastNpcEncountered = npc;\r\n    controller.moveSprite(player, 0, 0);\r\n    GameState.speaking = true;\r\n\r\n    if (npc === GameActors.healer) {\r\n        handleHealer();\r\n    } else if (npc === GameActors.townKeeper) {\r\n        handleBestiary();\r\n    } else if (npc === GameActors.bossfight) {\r\n        handleBossfight();\r\n    } else {\r\n        handleGenericNPC(npc);\r\n    }\r\n\r\n    pause(UI_CONFIG.BASIC_PAUSE);\r\n})\r\n\r\nscene.onOverlapTile(SpriteKind.Player, sprites.dungeon.doorClosedEast, function (player, location) {\r\n    teleport(location);\r\n})\r\n\r\nscene.onOverlapTile(SpriteKind.Player, sprites.dungeon.collectibleInsignia, function (player, location) {\r\n    color.startFade(color.originalPalette, color.Black, 500);\r\n    tiles.setCurrentTilemap(tilemap`mainLocation`);\r\n    GameActors.healer.destroy();\r\n    GameActors.healer = null;\r\n    placeAt(GameActors.player, LOCATIONS.PLAYER_LEAVE_HOSPITAL);\r\n    color.startFade(color.Black, color.originalPalette, 500);\r\n})\r\n\r\nscene.onOverlapTile(SpriteKind.Player, sprites.castle.tileGrass3, function (sprite, location) {\r\n    if (GameState.activeBattle || !GameState.gamePlay) return;\r\n    \r\n    if (!GameState.activeBattle && game.runtime() > lastEncounterCheck + (UI_CONFIG.BASIC_PAUSE * 2)) {\r\n\r\n        lastEncounterCheck = game.runtime();\r\n\r\n        if (randint(1, BALANCE_CONFIG.ENCOUNTER_CHANCE) === 1) {\r\n            sprite.setVelocity(0, 0);\r\n            \r\n            GameActors.player.setFlag(SpriteFlag.Ghost, true);\r\n            GameActors.lastNpcEncountered = null;\r\n\r\n            control.runInParallel(() => {\r\n                pause(10);\r\n                startFight();\r\n            });\r\n        }\r\n    }\r\n})\r\n\r\nscene.onOverlapTile(SpriteKind.Player, sprites.dungeon.stairLadder, function (player, location) {\r\n    if (GameState.speaking || GameState.activeBattle) return;\r\n    GameState.speaking = true;\r\n    controller.moveSprite(GameActors.player, 0, 0);\r\n    \r\n    if (GameState.timesLookedAtSign === 0) {\r\n        story.printCharacterText(\"Musíš porazit toho ducha.\", \"Cedule\");\r\n        story.printCharacterText(\"Tvoje příšery, ale musí být extrémně silné.\", \"Cedule\");\r\n        story.printCharacterText(\"B - otevřeš inventář\", \"Cedule\");\r\n        story.printCharacterText(\"Naraž do npc a oni začnou mluvit\", \"Cedule\");\r\n        story.printCharacterText(\"To je vše, hodně štěstí\", \"Cedule\");\r\n\r\n        GameState.timesLookedAtSign++;\r\n    } else if (GameState.timesLookedAtSign !== 50) {\r\n        story.printCharacterText(\"B - otevřeš inventář\", \"Cedule\");\r\n        story.printCharacterText(\"Naraž do npc a oni začnou mluvit\", \"Cedule\");\r\n        story.printCharacterText(\"Je možné že při vycházce budeš mít návštěvu\", \"Cedule\");\r\n\r\n        GameState.timesLookedAtSign++;\r\n    } else {\r\n        story.printCharacterText(\"Kolikrát mě ještě otevřeš????\", \"Cedule\");\r\n        \r\n        GameState.timesLookedAtSign++;\r\n    }\r\n\r\n    finishTalking();\r\n})\r\n\r\n\r\nstory.setSoundEnabled(false);\r\nscene.setBackgroundImage(assets.image`intro`);\r\nbigButton.sx = 0.8;\r\nbigButton.sy = 0.8;\r\nbigButton.setPosition(80, 60);\r\nanimation.runImageAnimation(bigButton, bigButtonAnimation, 500, true);\r\n\r\ngame.onUpdate(function () {\r\n    if (!GameState.gamePlay || GameState.inventoryOpen) return;\r